# Streamlit Community Cloud → 앱 Settings → Secrets 칸에 아래 형식으로 붙여 넣습니다(값은 직접 채움).
# 내 PC에서는 같은 내용을 .streamlit/secrets.toml 로 저장해도 됩니다(저장소에는 올라가지 않음).
ANTHROPIC_API_KEY = ""        # 없으면 AI 없이 규칙(간이 추출)으로 동작
ANTHROPIC_WORKSPACE_ID = ""   # 작업공간에 묶이지 않은 조직 키일 때만
APP_PASSWORD = ""             # 넣으면 접속할 때 이 비밀번호를 물어봄(공개 주소에서 AI 사용료 보호)
